# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# OpenAI-compatible API (used for LLM chat, analysis, and image generation)
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.cometapi.com/v1

# Alternative: CometAPI key (used for image generation if OPENAI_API_KEY not set)
# COMET_API_KEY=your-comet-api-key

# LLM Models (priority: CLI --model / --analysis-model -> .env -> default deepseek-v4.1-flash)
# Primary chat model (uses reasoning_effort=medium in chat)
# OPENAI_MODEL=deepseek-v4.1-flash
# Analytical model for /assoc, /lysis, and /remarque (uses reasoning_effort=high; falls back to OPENAI_MODEL if unset)
# OPENAI_ANALYSIS_MODEL=deepseek-v4-pro
# DEFAULT_LLM_MODEL

# USER_PREFS_ENCRYPTION_KEY=

# Generation limits & continuation policy (configured in ExistentialTherapistBot):
# - Chat and analysis requests currently use max_tokens=4096 per completion.
# - Chat uses reasoning_effort=medium; /assoc, /lysis and /remarque use high.
# - Truncated responses (finish_reason=length / max_tokens) are continued up to MAX_COMPLETION_CONTINUATIONS=2 times.
# - Incomplete or empty responses are rejected and not saved to conversation history.

# Vision model for image analysis
# VISION_MODEL=claude-sonnet-5

# Audio models
# WHISPER_MODEL=whisper-1
# TTS_MODEL=tts-1


# Admin Telegram user ID (must be a numeric integer ID, e.g. 123456789)
ADMIN_ID=0

# Default language (ru or en)
DEFAULT_LANG=ru

# Soft question-initiative preference (0.0 - 1.0), not a measured frequency or quota:
# < 0.33: more sparing with questions; 0.33 - 0.67: balanced; > 0.67: more open to asking.
# Users can adjust their own preference via /askprob <0.0-1.0> or /askprob reset.
# Crisis/safety assessment questions are always allowed regardless of this setting.
OPENAI_ASK_QUESTION_PROB=0.37

# Fernet encryption key for sensitive user data in data/user_prefs.json (required to persist user data)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# USER_PREFS_ENCRYPTION_KEY=your-fernet-key-here

# ---------------------------------------------------------------------------
# Film-frame feature (experimental)
# ---------------------------------------------------------------------------

# Enable the feature
FILM_FRAME_ENABLED=false

# Comma-separated numeric user IDs that ignore daily limits (empty = everyone uses limits)
# The admin (ADMIN_ID) always bypasses limits too.
FILM_FRAME_ALLOWED_USER_IDS=

# Image generation model
FILM_FRAME_MODEL=seedream-5-0-pro-260628

# Image API credentials (falls back to OPENAI_API_KEY / OPENAI_API_BASE)
# FILM_FRAME_IMAGE_API_KEY=
# FILM_FRAME_IMAGE_API_BASE=

# Scene-building LLM model (falls back to OPENAI_MODEL)
# FILM_FRAME_SCENE_LLM_MODEL=

# Daily limits
FILM_FRAME_PER_USER_DAILY_LIMIT=2
FILM_FRAME_GLOBAL_DAILY_LIMIT=50
