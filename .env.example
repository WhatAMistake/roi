# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# OpenAI-compatible API (used for LLM chat, analysis, and image generation)
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# Alternative: CometAPI key (used for image generation if OPENAI_API_KEY not set)
# COMET_API_KEY=your-comet-api-key

# LLM Models (override defaults)
# OPENAI_MODEL=deepseek-v4-pro
# OPENAI_ANALYSIS_MODEL=deepseek-v4-pro

# Vision model for image analysis
# VISION_MODEL=claude-sonnet-5

# Audio models
# WHISPER_MODEL=whisper-1
# TTS_MODEL=tts-1

# Summary model for admin summaries
# SUMMARY_MODEL=gpt-5.4-mini

# Admin
ADMIN_ID=282208693

# Default language (ru or en)
DEFAULT_LANG=ru

# Question probability (0.0 - 1.0)
OPENAI_ASK_QUESTION_PROB=0.37

# Encryption key for user data
# USER_PREFS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Film-frame feature (experimental)
# ---------------------------------------------------------------------------

# Enable the feature
FILM_FRAME_ENABLED=false

# Comma-separated list of allowed user IDs (empty = nobody)
FILM_FRAME_ALLOWED_USER_IDS=ADMIN_ID

# Image generation model
FILM_FRAME_MODEL=seedream-5-0-pro-260628

# Image API credentials (falls back to OPENAI_API_KEY / OPENAI_API_BASE)
# FILM_FRAME_IMAGE_API_KEY=
# FILM_FRAME_IMAGE_API_BASE=

# Scene-building LLM model (falls back to OPENAI_MODEL)
# FILM_FRAME_SCENE_LLM_MODEL=

# Daily limits
FILM_FRAME_PER_USER_DAILY_LIMIT=3
FILM_FRAME_GLOBAL_DAILY_LIMIT=50
